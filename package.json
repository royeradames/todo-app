{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4325",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4325",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts && npm run test:setup",
    "test:setup": "node tools/setup-coverage.mjs setup.json --root . --strict",
    "test:browser": "playwright test",
    "test:production": "playwright test -c playwright.production.config.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
