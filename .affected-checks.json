{
  "_about": "royer-merge change-scoped checks for todo-app (affected-checks.mjs reads a repo-root .affected-checks.json before the toolbox's file). Checks with \"boat\": true run on a boat box through run-checks.mjs. Added Oct 28, 2026 (bottleneck rollout).",
  "profiles": {
    "todo-app": {
      "remote": "todo-app",
      "docs": [
        "**/*.md",
        "**/*.MD",
        "**/*.txt",
        "docs/**",
        "reference/**",
        "artwork/**",
        ".gitignore"
      ],
      "instructions": [
        "AGENTS.md",
        "**/AGENTS.md",
        "CLAUDE.md",
        ".cursor/rules/**",
        ".affected-checks.json"
      ],
      "global": [
        "package.json",
        "package-lock.json",
        "bun.lock",
        "bunfig.toml",
        ".npmrc",
        "tsconfig.json",
        "next.config.ts",
        "next-env.d.ts",
        "eslint.config.mjs",
        "postcss.config.mjs",
        "playwright.config.ts",
        "playwright.production.config.ts",
        "vercel.json",
        ".github/**",
        "src/app/layout.tsx",
        "src/app/globals.css",
        "src/proxy.ts",
        "src/middleware.ts"
      ],
      "checks": [
        {
          "name": "typecheck",
          "what": "tsc --noEmit",
          "lane": "light",
          "independent": true,
          "boat": true,
          "cmd": "./node_modules/.bin/tsc --noEmit",
          "when": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.mts"
          ]
        },
        {
          "name": "lint",
          "what": "eslint . (the package.json lint script)",
          "lane": "light",
          "independent": true,
          "boat": true,
          "cmd": "./node_modules/.bin/eslint .",
          "when": [
            "**/*.ts",
            "**/*.tsx",
            "**/*.mts",
            "**/*.js",
            "**/*.mjs",
            "**/*.cjs",
            "**/*.jsx"
          ]
        },
        {
          "name": "unit",
          "what": "node unit tests (the package.json test script)",
          "lane": "light",
          "independent": true,
          "boat": true,
          "cmd": "node --import tsx --test tests/unit/*.test.ts && node tools/setup-coverage.mjs setup.json --root . --strict",
          "when": [
            "src/**",
            "tests/unit/**",
            "tools/**",
            "setup.json"
          ]
        },
        {
          "name": "build",
          "what": "next build",
          "lane": "heavy",
          "independent": true,
          "boat": true,
          "anyCode": true,
          "cmd": "./node_modules/.bin/next build",
          "when": [
            "src/**",
            "tools/**",
            "public/**"
          ]
        },
        {
          "name": "specs",
          "what": "the Playwright browser list against next dev, then the production build and its journeys against next start (CI's order)",
          "lane": "heavy",
          "independent": true,
          "cmd": "./node_modules/.bin/playwright test && ./node_modules/.bin/next build && ./node_modules/.bin/playwright test -c playwright.production.config.ts",
          "boat": true,
          "_boat": "The boat box image ships Google Chrome at /usr/bin/google-chrome, which the config's channel chrome uses.",
          "when": [
            "src/**",
            "tools/**",
            "public/**",
            "tests/browser/**",
            "tests/production/**"
          ]
        },
        {
          "name": "ui-quality-gate",
          "aliases": [
            "quality-gate"
          ],
          "what": "the UI quality gate on the pages the diff reaches, at promotion only; this repo ships main at merge, so it is the QA-at-promotion list's route source",
          "routes": true,
          "at": "promotion",
          "when": [
            "src/**",
            "public/**"
          ]
        },
        {
          "name": "qa",
          "what": "independent royer-qa on the PR's own surface",
          "at": "promotion",
          "routes": true,
          "when": [
            "src/**",
            "public/**"
          ],
          "instructionsToo": true
        },
        {
          "name": "qa-gate",
          "what": "QA at the head before merge (auth, payments, secrets, deploy config)",
          "carryAs": "qa",
          "gate": [
            "vercel.json",
            ".env*",
            "**/.env*",
            "setup.json",
            ".github/workflows/**",
            "middleware.*",
            "proxy.*",
            "src/app/api/**",
            "src/middleware.*",
            "src/proxy.*"
          ]
        }
      ],
      "setup": "[ -d node_modules ] || npm ci --no-audit --no-fund > /dev/null 2>&1",
      "_setup": "npm stays this repo's package manager for now (see the PR that added this file).",
      "setupWhenMissing": "node_modules",
      "boat": {
        "setup": "true",
        "_setup": "The box image's Node and npm are enough."
      }
    }
  }
}
